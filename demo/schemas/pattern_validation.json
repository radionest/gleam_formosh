{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/schemas/pattern-validation.json",
  "title": "Валидация по регулярным выражениям",
  "description": "Демонстрация JSON Schema keyword `pattern`. Каждое поле проверяется regex-выражением; некорректный ввод подсвечивается ошибкой «Does not match the required format».",
  "type": "object",
  "properties": {
    "username": {
      "type": "string",
      "title": "Имя пользователя",
      "pattern": "^[a-zA-Z0-9_]{3,20}$"
    },
    "postalCode": {
      "type": "string",
      "title": "Почтовый индекс",
      "pattern": "^[0-9]{6}$"
    },
    "phone": {
      "type": "string",
      "title": "Телефон",
      "pattern": "^\\+7 ?\\(?[0-9]{3}\\)? ?[0-9]{3}[- ]?[0-9]{2}[- ]?[0-9]{2}$"
    },
    "hexColor": {
      "type": "string",
      "title": "HEX-цвет",
      "pattern": "^#[0-9a-fA-F]{6}$"
    },
    "slug": {
      "type": "string",
      "title": "URL-slug",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "ipv4": {
      "type": "string",
      "title": "IPv4-адрес",
      "pattern": "^(?:(?:25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)\\.){3}(?:25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)$"
    }
  },
  "required": ["username", "postalCode"]
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "Account setup",
  "description": "Password and confirmation must match. Enforced by a JS cross-field validator (JSON Schema cannot compare two field values).",
  "properties": {
    "email": {
      "type": "string",
      "format": "email",
      "title": "Email"
    },
    "password": {
      "type": "string",
      "minLength": 8,
      "title": "Password"
    },
    "confirm_password": {
      "type": "string",
      "minLength": 8,
      "title": "Confirm password"
    }
  },
  "required": ["email", "password", "confirm_password"]
}

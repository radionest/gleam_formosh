{
  "title": "Hidden Fields Demo (x-widget: hidden)",
  "description": "Demonstrates x-widget: \"hidden\" — fields are suppressed from the UI but still appear in the submit payload and participate in validation. Open browser DevTools and watch the network tab on submit (or the example's submission display) to see hidden fields included.",
  "type": "object",
  "required": ["email", "tenant_id"],
  "properties": {
    "tenant_id": {
      "type": "string",
      "title": "Tenant ID (hidden — default injected)",
      "x-widget": "hidden",
      "default": "acme-corp"
    },
    "form_version": {
      "type": "integer",
      "title": "Form version (hidden)",
      "x-widget": "hidden",
      "default": 3
    },
    "source": {
      "type": "string",
      "title": "Source (hidden, no default)",
      "x-widget": "hidden"
    },
    "email": {
      "type": "string",
      "title": "Email",
      "format": "email",
      "description": "Visible field — required. Submit will include hidden defaults alongside this value."
    },
    "preferences": {
      "type": "object",
      "title": "Preferences",
      "properties": {
        "newsletter": {
          "type": "boolean",
          "title": "Subscribe to newsletter",
          "default": true
        },
        "_internal_segment": {
          "type": "string",
          "title": "Internal segment (hidden, nested)",
          "x-widget": "hidden",
          "default": "beta-cohort"
        }
      }
    },
    "tags": {
      "type": "array",
      "title": "Tags (hidden entirely as array)",
      "x-widget": "hidden",
      "default": ["imported", "v3"],
      "items": { "type": "string" }
    }
  }
}

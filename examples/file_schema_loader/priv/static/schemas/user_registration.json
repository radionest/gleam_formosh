{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/schemas/user-registration.json",
  "title": "Регистрация пользователя",
  "description": "Форма регистрации нового пользователя в системе",
  "type": "object",
  "properties": {
    "personalInfo": {
      "type": "object",
      "title": "Личная информация",
      "properties": {
        "firstName": {
          "type": "string",
          "title": "Имя",
          "minLength": 2,
          "maxLength": 50
        },
        "lastName": {
          "type": "string",
          "title": "Фамилия",
          "minLength": 2,
          "maxLength": 50
        },
        "middleName": {
          "type": "string",
          "title": "Отчество",
          "maxLength": 50
        },
        "birthDate": {
          "type": "string",
          "title": "Дата рождения",
          "format": "date"
        },
        "gender": {
          "type": "string",
          "title": "Пол",
          "enum": ["Мужской", "Женский", "Не указано"]
        },
        "age": {
          "type": "integer",
          "title": "Возраст",
          "minimum": 18,
          "maximum": 120
        }
      },
      "required": ["firstName", "lastName", "birthDate"]
    },
    "accountInfo": {
      "type": "object",
      "title": "Данные аккаунта",
      "properties": {
        "username": {
          "type": "string",
          "title": "Имя пользователя",
          "description": "Будет использоваться для входа в систему",
          "pattern": "^[a-zA-Z0-9_]{3,20}$",
          "minLength": 3,
          "maxLength": 20
        },
        "email": {
          "type": "string",
          "title": "Email",
          "format": "email"
        },
        "emailConfirm": {
          "type": "string",
          "title": "Подтвердите email",
          "format": "email"
        },
        "password": {
          "type": "string",
          "title": "Пароль",
          "description": "Минимум 8 символов, включая цифры и буквы",
          "minLength": 8,
          "maxLength": 50
        },
        "passwordConfirm": {
          "type": "string",
          "title": "Подтвердите пароль",
          "minLength": 8,
          "maxLength": 50
        }
      },
      "required": ["username", "email", "emailConfirm", "password", "passwordConfirm"]
    },
    "address": {
      "type": "object",
      "title": "Адрес",
      "properties": {
        "country": {
          "type": "string",
          "title": "Страна",
          "enum": [
            "Россия",
            "Беларусь",
            "Казахстан",
            "Украина",
            "Армения",
            "Азербайджан",
            "Грузия",
            "Кыргызстан",
            "Молдова",
            "Таджикистан",
            "Туркменистан",
            "Узбекистан"
          ]
        },
        "city": {
          "type": "string",
          "title": "Город",
          "minLength": 2,
          "maxLength": 100
        },
        "postalCode": {
          "type": "string",
          "title": "Почтовый индекс",
          "pattern": "^[0-9]{6}$"
        },
        "street": {
          "type": "string",
          "title": "Улица",
          "maxLength": 200
        },
        "building": {
          "type": "string",
          "title": "Дом",
          "maxLength": 20
        },
        "apartment": {
          "type": "string",
          "title": "Квартира",
          "maxLength": 20
        }
      },
      "required": ["country", "city"]
    },
    "preferences": {
      "type": "object",
      "title": "Настройки и предпочтения",
      "properties": {
        "newsletter": {
          "type": "boolean",
          "title": "Получать новостную рассылку"
        },
        "notifications": {
          "type": "array",
          "title": "Типы уведомлений",
          "description": "Выберите, какие уведомления вы хотите получать",
          "items": {
            "type": "string",
            "enum": ["Email", "SMS", "Push-уведомления", "Телефон"]
          },
          "uniqueItems": true
        },
        "language": {
          "type": "string",
          "title": "Предпочитаемый язык",
          "enum": ["Русский", "English", "Español", "Deutsch", "Français"],
          "default": "Русский"
        },
        "timezone": {
          "type": "string",
          "title": "Часовой пояс",
          "enum": [
            "UTC+2 (Калининград)",
            "UTC+3 (Москва)",
            "UTC+4 (Самара)",
            "UTC+5 (Екатеринбург)",
            "UTC+6 (Омск)",
            "UTC+7 (Красноярск)",
            "UTC+8 (Иркутск)",
            "UTC+9 (Якутск)",
            "UTC+10 (Владивосток)",
            "UTC+11 (Магадан)",
            "UTC+12 (Камчатка)"
          ],
          "default": "UTC+3 (Москва)"
        }
      }
    },
    "professionalInfo": {
      "type": "object",
      "title": "Профессиональная информация",
      "properties": {
        "occupation": {
          "type": "string",
          "title": "Род деятельности",
          "maxLength": 100
        },
        "company": {
          "type": "string",
          "title": "Компания",
          "maxLength": 100
        },
        "experience": {
          "type": "integer",
          "title": "Опыт работы (лет)",
          "minimum": 0,
          "maximum": 50
        },
        "skills": {
          "type": "array",
          "title": "Навыки",
          "description": "Добавьте ваши профессиональные навыки",
          "items": {
            "type": "string",
            "maxLength": 50
          },
          "maxItems": 10
        }
      }
    },
    "agreement": {
      "type": "object",
      "title": "Согласия и подтверждения",
      "properties": {
        "termsAccepted": {
          "type": "boolean",
          "title": "Я принимаю условия пользовательского соглашения",
          "const": true
        },
        "privacyAccepted": {
          "type": "boolean",
          "title": "Я согласен с политикой конфиденциальности",
          "const": true
        },
        "dataProcessing": {
          "type": "boolean",
          "title": "Я даю согласие на обработку персональных данных",
          "const": true
        },
        "ageConfirmation": {
          "type": "boolean",
          "title": "Я подтверждаю, что мне исполнилось 18 лет",
          "const": true
        }
      },
      "required": ["termsAccepted", "privacyAccepted", "dataProcessing", "ageConfirmation"]
    }
  },
  "required": ["personalInfo", "accountInfo", "address", "agreement"]
}
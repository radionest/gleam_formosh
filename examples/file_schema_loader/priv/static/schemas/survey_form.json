{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/schemas/survey-form.json",
  "title": "Опрос удовлетворенности клиентов",
  "description": "Помогите нам улучшить наш сервис, ответив на несколько вопросов",
  "type": "object",
  "properties": {
    "respondentInfo": {
      "type": "object",
      "title": "Информация о респонденте",
      "properties": {
        "name": {
          "type": "string",
          "title": "Ваше имя (необязательно)",
          "maxLength": 100
        },
        "email": {
          "type": "string",
          "title": "Email для обратной связи",
          "format": "email"
        },
        "customerType": {
          "type": "string",
          "title": "Тип клиента",
          "enum": [
            "Новый клиент",
            "Постоянный клиент",
            "VIP клиент",
            "Корпоративный клиент"
          ]
        },
        "usageDuration": {
          "type": "string",
          "title": "Как долго вы пользуетесь нашими услугами?",
          "enum": [
            "Менее месяца",
            "1-3 месяца",
            "3-6 месяцев",
            "6-12 месяцев",
            "Более года",
            "Более 3 лет"
          ]
        }
      },
      "required": ["customerType", "usageDuration"]
    },
    "serviceRating": {
      "type": "object",
      "title": "Оценка качества обслуживания",
      "properties": {
        "overallSatisfaction": {
          "type": "integer",
          "title": "Общая удовлетворенность (1-10)",
          "minimum": 1,
          "maximum": 10
        },
        "recommendationLikelihood": {
          "type": "integer",
          "title": "Насколько вероятно, что вы порекомендуете нас друзьям? (1-10)",
          "minimum": 1,
          "maximum": 10
        },
        "supportQuality": {
          "type": "integer",
          "title": "Качество поддержки клиентов (1-5)",
          "minimum": 1,
          "maximum": 5
        },
        "productQuality": {
          "type": "integer",
          "title": "Качество продукта/услуги (1-5)",
          "minimum": 1,
          "maximum": 5
        },
        "valueForMoney": {
          "type": "integer",
          "title": "Соотношение цена/качество (1-5)",
          "minimum": 1,
          "maximum": 5
        }
      },
      "required": ["overallSatisfaction", "recommendationLikelihood"]
    },
    "usagePatterns": {
      "type": "object",
      "title": "Как вы используете наш сервис",
      "properties": {
        "frequency": {
          "type": "string",
          "title": "Частота использования",
          "enum": [
            "Ежедневно",
            "Несколько раз в неделю",
            "Раз в неделю",
            "Несколько раз в месяц",
            "Раз в месяц",
            "Реже"
          ]
        },
        "primaryPurpose": {
          "type": "array",
          "title": "Основные цели использования (выберите все подходящие)",
          "items": {
            "type": "string",
            "enum": [
              "Личное использование",
              "Работа",
              "Учеба",
              "Развлечение",
              "Общение",
              "Покупки",
              "Исследования",
              "Другое"
            ]
          },
          "uniqueItems": true,
          "minItems": 1
        },
        "favoriteFeatures": {
          "type": "array",
          "title": "Любимые функции",
          "description": "Какие функции вам нравятся больше всего?",
          "items": {
            "type": "string",
            "maxLength": 100
          },
          "maxItems": 5
        }
      },
      "required": ["frequency", "primaryPurpose"]
    },
    "improvements": {
      "type": "object",
      "title": "Предложения по улучшению",
      "properties": {
        "problemsEncountered": {
          "type": "array",
          "title": "С какими проблемами вы сталкивались?",
          "items": {
            "type": "string",
            "enum": [
              "Медленная работа",
              "Сложный интерфейс",
              "Ошибки и сбои",
              "Недостаток функций",
              "Проблемы с оплатой",
              "Плохая поддержка",
              "Проблемы с безопасностью",
              "Другое"
            ]
          },
          "uniqueItems": true
        },
        "missingFeatures": {
          "type": "string",
          "title": "Каких функций вам не хватает?",
          "maxLength": 500
        },
        "generalFeedback": {
          "type": "string",
          "title": "Общие комментарии и предложения",
          "description": "Расскажите, что мы можем улучшить",
          "maxLength": 1000
        }
      }
    },
    "competitorComparison": {
      "type": "object",
      "title": "Сравнение с конкурентами",
      "properties": {
        "useCompetitors": {
          "type": "boolean",
          "title": "Используете ли вы аналогичные сервисы?"
        },
        "competitorNames": {
          "type": "array",
          "title": "Какие аналогичные сервисы вы используете?",
          "items": {
            "type": "string",
            "maxLength": 50
          },
          "maxItems": 5
        },
        "preferenceReason": {
          "type": "string",
          "title": "Почему вы выбрали наш сервис?",
          "enum": [
            "Лучшая цена",
            "Больше функций",
            "Удобнее интерфейс",
            "Лучшая поддержка",
            "Рекомендации друзей",
            "Репутация бренда",
            "Другое"
          ]
        }
      }
    },
    "futureEngagement": {
      "type": "object",
      "title": "Будущее взаимодействие",
      "properties": {
        "continuationLikelihood": {
          "type": "string",
          "title": "Планируете ли вы продолжать использовать наш сервис?",
          "enum": [
            "Определенно да",
            "Скорее да",
            "Не уверен",
            "Скорее нет",
            "Определенно нет"
          ]
        },
        "interestedInUpdates": {
          "type": "boolean",
          "title": "Хотите получать информацию о новых функциях?"
        },
        "participateInBeta": {
          "type": "boolean",
          "title": "Готовы участвовать в тестировании новых функций?"
        },
        "joinFocusGroup": {
          "type": "boolean",
          "title": "Хотите присоединиться к фокус-группе?"
        }
      },
      "required": ["continuationLikelihood"]
    },
    "demographics": {
      "type": "object",
      "title": "Демографическая информация (необязательно)",
      "properties": {
        "ageRange": {
          "type": "string",
          "title": "Возрастная группа",
          "enum": [
            "До 18",
            "18-24",
            "25-34",
            "35-44",
            "45-54",
            "55-64",
            "65+"
          ]
        },
        "industry": {
          "type": "string",
          "title": "Сфера деятельности",
          "enum": [
            "IT и технологии",
            "Финансы и банкинг",
            "Здравоохранение",
            "Образование",
            "Розничная торговля",
            "Производство",
            "Государственный сектор",
            "НКО",
            "Медиа и развлечения",
            "Транспорт и логистика",
            "Другое"
          ]
        },
        "companySize": {
          "type": "string",
          "title": "Размер компании",
          "enum": [
            "Индивидуальный предприниматель",
            "1-10 сотрудников",
            "11-50 сотрудников",
            "51-200 сотрудников",
            "201-500 сотрудников",
            "Более 500 сотрудников"
          ]
        }
      }
    },
    "contactPermission": {
      "type": "boolean",
      "title": "Можем ли мы связаться с вами для уточнения ответов?",
      "default": false
    }
  },
  "required": ["serviceRating", "usagePatterns", "futureEngagement"]
}
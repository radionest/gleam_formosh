{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/array_readonly_test_full.schema.json",
  "title": "Array readOnly full cascade (regression control)",
  "description": "Контроль обратной совместимости: readOnly:true на массиве по-прежнему каскадирует на все поля внутри. Если этот тест ломается, мы случайно сняли каскад.",
  "type": "object",
  "properties": {
    "lesions": {
      "type": "array",
      "readOnly": true,
      "title": "Очаги (всё заморожено)",
      "description": "readOnly:true должен сделать ВСЕ дочерние поля нередактируемыми и скрыть add/remove",
      "default": [
        {
          "lesion_num": 1,
          "is_resected": false
        },
        {
          "lesion_num": 2,
          "is_resected": true,
          "visible": true,
          "tumor_cells": false,
          "conclusion": "Резидуальная опухоль не выявлена"
        }
      ],
      "items": {
        "type": "object",
        "properties": {
          "lesion_num": {
            "type": "integer",
            "title": "Номер очага"
          },
          "is_resected": {
            "type": "boolean",
            "title": "Очаг резецирован"
          }
        },
        "required": ["lesion_num", "is_resected"],
        "allOf": [
          {
            "if": {
              "properties": { "is_resected": { "const": true } }
            },
            "then": {
              "properties": {
                "visible": {
                  "type": "boolean",
                  "title": "Очаг визуализируется на препарате"
                },
                "tumor_cells": {
                  "type": "boolean",
                  "title": "Опухолевые клетки в препарате"
                },
                "conclusion": {
                  "type": "string",
                  "title": "Заключение"
                }
              },
              "required": ["visible", "tumor_cells", "conclusion"]
            }
          }
        ]
      }
    }
  }
}
